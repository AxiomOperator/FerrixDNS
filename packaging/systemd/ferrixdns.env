# Starting settings for the ferrixdns service. After changing this: systemctl restart ferrixdns
# Every option is listed by: ferrixdns serve --help
#
# All of these can also be changed in the dashboard, under Settings. A value changed there wins over
# this file. To go back to this file: ferrixdns admin reset-settings --state-dir /var/lib/ferrixdns
# Keep FERRIXDNS_STATE_DIR as it is, even if the data moves, because saved settings stay in that folder.

# Where to answer DNS, comma separated. Use this machine's LAN address to serve other devices,
# because systemd-resolved usually holds 127.0.0.53 and sometimes all addresses on port 53.
FERRIXDNS_LISTEN=127.0.0.1:53

# Upstream servers, tried in order. For encrypted DNS, use for example:
#   FERRIXDNS_UPSTREAM=tls://cloudflare-dns.com@1.1.1.1,tls://dns.quad9.net@9.9.9.9
FERRIXDNS_UPSTREAM=1.1.1.1,9.9.9.9
# Share queries between them, instead of using the first one that works.
#FERRIXDNS_UPSTREAM_LOAD_BALANCE=true

FERRIXDNS_STATE_DIR=/var/lib/ferrixdns

# The dashboard. On a network address it needs TLS, using one of:
#   FERRIXDNS_WEB_TLS_SELF_SIGNED=true
#   FERRIXDNS_WEB_TLS_CERT=/etc/ferrixdns/cert.pem and FERRIXDNS_WEB_TLS_KEY=/etc/ferrixdns/key.pem
# It also needs the names people will use to reach it, such as FERRIXDNS_WEB_HOST=dns.home.arpa,192.168.1.10
FERRIXDNS_WEB_LISTEN=127.0.0.1:8080

# Validate answers with DNSSEC on this node. Upstreams must return signatures.
#FERRIXDNS_DNSSEC_VALIDATE=true

# Share this machine's clock over NTP, for devices that can't reach a public time server. Port 123
# must be free, so don't run chrony or ntpd as a server here. systemd-timesyncd is only a client.
#FERRIXDNS_NTP_LISTEN=192.168.1.10:123

# Manage this node from a central controller. The token is only needed to join. To serve no dashboard
# here, also set FERRIXDNS_NO_WEB=true. See docs/operations/controller.md.
#FERRIXDNS_ENROLL_TOKEN=fxn1_...
#FERRIXDNS_NO_WEB=true
