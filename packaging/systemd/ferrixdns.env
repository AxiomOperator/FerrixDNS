# Settings for the ferrixdns service. After changing this: systemctl restart ferrixdns
# Every option is listed by: fx serve --help

# Where to answer DNS, comma separated. Use this machine's LAN address to serve other devices,
# because systemd-resolved usually holds 127.0.0.53 and sometimes all addresses on port 53.
FX_LISTEN=127.0.0.1:53

# Upstream servers, tried in order. For encrypted DNS, use for example:
#   FX_UPSTREAM=tls://cloudflare-dns.com@1.1.1.1,tls://dns.quad9.net@9.9.9.9
FX_UPSTREAM=1.1.1.1,9.9.9.9

FX_STATE_DIR=/var/lib/ferrixdns

# The dashboard. On a network address it needs TLS, using one of:
#   FX_WEB_TLS_SELF_SIGNED=true
#   FX_WEB_TLS_CERT=/etc/ferrixdns/cert.pem and FX_WEB_TLS_KEY=/etc/ferrixdns/key.pem
# It also needs the names people will use to reach it, such as FX_WEB_HOST=dns.home.arpa,192.168.1.10
FX_WEB_LISTEN=127.0.0.1:8080

# Validate answers with DNSSEC on this node. Upstreams must return signatures.
#FX_DNSSEC_VALIDATE=true
