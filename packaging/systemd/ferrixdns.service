[Unit]
Description=FerrixDNS node
Documentation=https://github.com/AxiomOperator/FerrixDNS
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/ferrixdns/ferrixdns.env
ExecStart=/usr/bin/ferrixdns serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Query logs and the database are private to this service.
UMask=0077
StateDirectory=ferrixdns
StateDirectoryMode=0700
# Each in-flight upstream query uses a socket, so this must exceed --max-concurrent-requests.
LimitNOFILE=65536

# The hardening below keeps a compromised process away from the rest of the system.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# ProtectClock would also block reading the clock's state, which NTP replies depend on. Setting the
# clock still can't happen, because CAP_SYS_TIME isn't in the capability bounding set.
ProtectClock=no
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK reads the neighbor table, which is how MAC addresses are learned.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Reading the clock's state, for NTP replies. glibc's adjtimex() uses clock_adjtime.
SystemCallFilter=adjtimex clock_adjtime
# Refuse anything else that's filtered, instead of killing the process, so a system call that only
# one feature needs can never take DNS down with it.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
